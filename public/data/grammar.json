[{"id":"g5-01","lv":5,"t":"～は ～です","m":"A adalah B","p":"[kata benda] は [kata benda] です","x":["Pola kalimat paling dasar. は (dibaca \"wa\") menandai topik kalimat, です membuat kalimat menjadi sopan.","Bahasa Jepang tidak punya kata \"adalah\"; cukup \"A は B です\"."],"ex":[{"t":["{私|わたし}","+は","{学生|がくせい}","+です。"],"id":"Saya (adalah) pelajar.","k":1},{"t":["{田中|たなか}さん","+は","{先生|せんせい}","+です。"],"id":"Pak Tanaka adalah guru.","k":1},{"t":["これ","+は","{本|ほん}","+です。"],"id":"Ini (adalah) buku.","k":1}],"o":["を","に","で"]},{"id":"g5-02","lv":5,"t":"～じゃありません","m":"A bukan B","p":"[kata benda] は [kata benda] じゃありません","x":["Bentuk negatif dari です. Versi lebih formal: ではありません. Versi santai: じゃない."],"ex":[{"t":["{私|わたし}","+は","{先生|せんせい}","+じゃありません。"],"id":"Saya bukan guru.","k":3},{"t":["これ","+は","{水|みず}","+じゃありません。"],"id":"Ini bukan air.","k":3},{"t":["{山田|やまだ}さん","+は","{日本人|にほんじん}","+ではありません。"],"id":"Pak Yamada bukan orang Jepang.","k":3}],"o":["です。","でした。","ます。"]},{"id":"g5-03","lv":5,"t":"～か","m":"kalimat tanya","p":"[kalimat] + か","x":["Tambahkan か di akhir kalimat untuk bertanya. Intonasi naik di akhir. Tanda tanya (？) boleh tidak dipakai."],"ex":[{"t":["あなた","+は","{学生|がくせい}","+です","+か。"],"id":"Apakah kamu pelajar?","k":4},{"t":["これ","+は","{何|なん}","+です","+か。"],"id":"Ini apa?","k":4},{"t":["トイレ","+は","どこ","+です","+か。"],"id":"Toiletnya di mana?","k":4}],"o":["ね。","よ。","を。"]},{"id":"g5-04","lv":5,"t":"～の～","m":"milik; ... dari ...","p":"[kata benda 1] の [kata benda 2]","x":["の menghubungkan dua kata benda: kepemilikan (\"buku saya\") atau keterangan (\"guru bahasa Jepang\").","Urutannya terbalik dari bahasa Indonesia: 私の本 = buku saya."],"ex":[{"t":["これ","+は","{私|わたし}","+の","{本|ほん}","+です。"],"id":"Ini buku saya.","k":3},{"t":["{日本語|にほんご}","+の","{先生|せんせい}","+です。"],"id":"(Beliau) guru bahasa Jepang.","k":1},{"t":["あれ","+は","{誰|だれ}","+の","{傘|かさ}","+です","+か。"],"id":"Itu payung siapa?","k":3}],"o":["は","を","に"]},{"id":"g5-05","lv":5,"t":"～も","m":"juga","p":"[kata benda] も ...","x":["も berarti \"juga\" dan menggantikan partikel は, が, atau を."],"ex":[{"t":["{私|わたし}","+も","{学生|がくせい}","+です。"],"id":"Saya juga pelajar.","k":1},{"t":["{田中|たなか}さん","+も","{来|き}ます。"],"id":"Pak Tanaka juga datang.","k":1},{"t":["これ","+も","{百円|ひゃくえん}","+です。"],"id":"Ini juga seratus yen.","k":1}],"o":["の","を","に"]},{"id":"g5-06","lv":5,"t":"これ・それ・あれ","m":"ini, itu, itu (jauh)","p":"これ / それ / あれ / どれ は ...","x":["これ = benda di dekat pembicara, それ = di dekat lawan bicara, あれ = jauh dari keduanya, どれ = yang mana.","Di depan kata benda pakai この / その / あの / どの: この本 = buku ini."],"ex":[{"t":["それ","+は","{何|なん}","+です","+か。"],"id":"Itu (yang di dekatmu) apa?","k":0,"o":["これ","どこ","この"]},{"t":["あれ","+は","{私|わたし}","+の","{車|くるま}","+です。"],"id":"Itu (yang jauh di sana) mobil saya.","k":0,"o":["それ","あそこ","あの"]},{"t":["この","{本|ほん}","+は","{高|たか}い","+です。"],"id":"Buku ini mahal.","k":0,"o":["これ","ここ","どれ"]}],"o":[]},{"id":"g5-07","lv":5,"t":"ここ・そこ・あそこ","m":"di sini, di situ, di sana","p":"[kata benda] は ここ / そこ / あそこ / どこ です","x":["Kata penunjuk tempat. どこ = di mana. Versi sopan: こちら・そちら・あちら・どちら."],"ex":[{"t":["トイレ","+は","あそこ","+です。"],"id":"Toilet ada di sana (jauh).","k":2,"o":["ここ","あれ","あの"]},{"t":["{駅|えき}","+は","どこ","+です","+か。"],"id":"Stasiun di mana?","k":2,"o":["だれ","なに","いつ"]},{"t":["ここ","+は","{教室|きょうしつ}","+です。"],"id":"Tempat ini adalah ruang kelas.","k":0,"o":["どこ","あの","どの"]}],"o":[]},{"id":"g5-08","lv":5,"t":"～に ～が あります／います","m":"ada (benda / makhluk hidup)","p":"[tempat] に [kata benda] が あります / います","x":["あります untuk benda mati dan tumbuhan; います untuk manusia dan hewan. に menandai tempat keberadaan."],"ex":[{"t":["{机|つくえ}","+の","{上|うえ}","+に","{本|ほん}","+が","あります。"],"id":"Ada buku di atas meja.","k":6,"o":["います。","です。","します。"]},{"t":["{公園|こうえん}","+に","{犬|いぬ}","+が","います。"],"id":"Ada anjing di taman.","k":4,"o":["あります。","です。","します。"]},{"t":["{教室|きょうしつ}","+に","{先生|せんせい}","+が","います。"],"id":"Ada guru di ruang kelas.","k":4,"o":["あります。","です。","します。"]}],"o":[]},{"id":"g5-09","lv":5,"t":"～を","m":"partikel objek","p":"[kata benda] を [kata kerja]","x":["を (dibaca \"o\") menandai objek yang dikenai pekerjaan: makan APA, membaca APA."],"ex":[{"t":["{水|みず}","+を","{飲|の}みます。"],"id":"Saya minum air.","k":1},{"t":["{毎朝|まいあさ}","パン","+を","{食|た}べます。"],"id":"Setiap pagi saya makan roti.","k":2},{"t":["{本|ほん}","+を","{読|よ}みます。"],"id":"Saya membaca buku.","k":1}],"o":["に","で","へ"]},{"id":"g5-10","lv":5,"t":"～ます／～ません","m":"kata kerja sopan (sekarang/nanti)","p":"[kata kerja]-ます (positif) / -ません (negatif)","x":["Bentuk ます adalah bentuk sopan kata kerja, dipakai untuk kebiasaan atau hal yang akan datang.","Ganti ます menjadi ません untuk negatif: 食べます (makan) → 食べません (tidak makan)."],"ex":[{"t":["{私|わたし}","+は","{肉|にく}","+を","{食|た}べ","~ません。"],"id":"Saya tidak makan daging.","k":5,"o":["ます。","ました。"]},{"t":["{毎日|まいにち}","{日本語|にほんご}","+を","{勉強|べんきょう}し","~ます。"],"id":"Setiap hari saya belajar bahasa Jepang.","k":4,"o":["ません。","ました。"]},{"t":["{明日|あした}","{学校|がっこう}","+へ","{行|い}き","~ます。"],"id":"Besok saya pergi ke sekolah.","k":4,"o":["ません。","ました。"]}],"o":[]},{"id":"g5-11","lv":5,"t":"～ました／～ませんでした","m":"kata kerja sopan (lampau)","p":"[kata kerja]-ました / -ませんでした","x":["Untuk kejadian yang sudah lewat: 食べました (sudah makan), 食べませんでした (tidak makan)."],"ex":[{"t":["{昨日|きのう}","{映画|えいが}","+を","{見|み}","~ました。"],"id":"Kemarin saya menonton film.","k":4,"o":["ます。","ません。"]},{"t":["{今朝|けさ}","{朝|あさ}ごはん","+を","{食|た}べ","~ませんでした。"],"id":"Tadi pagi saya tidak sarapan.","k":4,"o":["ます。","ました。"]},{"t":["{先週|せんしゅう}","{京都|きょうと}","+へ","{行|い}き","~ました。"],"id":"Minggu lalu saya pergi ke Kyoto.","k":4,"o":["ます。","ません。"]}],"o":[]},{"id":"g5-12","lv":5,"t":"～へ／～に 行きます","m":"pergi ke ...","p":"[tempat] へ / に 行きます・来ます・帰ります","x":["へ (dibaca \"e\") atau に menunjukkan arah tujuan. Dipakai dengan 行きます (pergi), 来ます (datang), 帰ります (pulang)."],"ex":[{"t":["{日本|にほん}","+へ","{行|い}きます。"],"id":"Saya pergi ke Jepang.","k":1,"o":["を","で","が"]},{"t":["{八時|はちじ}","+に","うち","+へ","{帰|かえ}ります。"],"id":"Saya pulang ke rumah jam 8.","k":3,"o":["を","で","が"]},{"t":["{友達|ともだち}","+が","{家|いえ}","+に","{来|き}ました。"],"id":"Teman datang ke rumah.","k":3,"o":["を","で","の"]}],"o":[]},{"id":"g5-13","lv":5,"t":"～で","m":"di (tempat kegiatan); dengan (alat)","p":"[tempat] で [kata kerja] / [alat] で [kata kerja]","x":["で menandai tempat terjadinya kegiatan (makan DI restoran) atau alat/cara (pergi DENGAN bus)."],"ex":[{"t":["{図書館|としょかん}","+で","{勉強|べんきょう}します。"],"id":"Saya belajar di perpustakaan.","k":1,"o":["に","を","へ"]},{"t":["バス","+で","{学校|がっこう}","+へ","{行|い}きます。"],"id":"Saya pergi ke sekolah naik bus.","k":1,"o":["を","が","の"]},{"t":["{箸|はし}","+で","ご{飯|はん}","+を","{食|た}べます。"],"id":"Saya makan nasi dengan sumpit.","k":1,"o":["に","が","へ"]}],"o":[]},{"id":"g5-14","lv":5,"t":"～と","m":"dan; bersama","p":"[kata benda 1] と [kata benda 2] / [orang] と [kata kerja]","x":["と menghubungkan kata benda (\"A dan B\") atau berarti \"bersama (seseorang)\"."],"ex":[{"t":["パン","+と","{卵|たまご}","+を","{食|た}べます。"],"id":"Saya makan roti dan telur.","k":1,"o":["を","で","に"]},{"t":["{友達|ともだち}","+と","{映画|えいが}","+を","{見|み}ました。"],"id":"Saya menonton film bersama teman.","k":1,"o":["を","で","が"]},{"t":["{母|はは}","+と","{買|か}い{物|もの}","+に","{行|い}きます。"],"id":"Saya pergi belanja bersama ibu.","k":1,"o":["を","が","の"]}],"o":[]},{"id":"g5-15","lv":5,"t":"～が 好きです","m":"suka ...","p":"[kata benda] が 好きです / 嫌いです / 上手です / 下手です","x":["Untuk suka/tidak suka dan pandai/tidak pandai, objeknya ditandai が (bukan を)."],"ex":[{"t":["{私|わたし}","+は","{猫|ねこ}","+が","{好|す}き","+です。"],"id":"Saya suka kucing.","k":3,"o":["を","で","に"]},{"t":["{兄|あに}","+は","{料理|りょうり}","+が","{上手|じょうず}","+です。"],"id":"Kakak laki-laki saya pandai memasak.","k":3,"o":["を","で","へ"]},{"t":["{私|わたし}","+は","{野菜|やさい}","+が","{嫌|きら}い","+です。"],"id":"Saya tidak suka sayur.","k":3,"o":["を","で","に"]}],"o":[]},{"id":"g5-16","lv":5,"t":"kata sifat -い","m":"～いです・～くないです","p":"[kata sifat]-い です / -くない です","x":["Kata sifat -i berakhiran い. Untuk negatif, ganti い menjadi くない: 高い (mahal) → 高くない (tidak mahal).","Pengecualian: いい (bagus) → よくない (tidak bagus)."],"ex":[{"t":["{今日|きょう}","+は","{寒|さむ}","~くない","+です。"],"id":"Hari ini tidak dingin.","k":3,"o":["い","かった","くて"]},{"t":["この","{本|ほん}","+は","{面白|おもしろ}","~い","+です。"],"id":"Buku ini menarik.","k":4,"o":["くない","かった","な"]},{"t":["{日本語|にほんご}","+は","{難|むずか}し","~くない","+です。"],"id":"Bahasa Jepang tidak sulit.","k":3,"o":["い","かった","な"]}],"o":[]},{"id":"g5-17","lv":5,"t":"kata sifat -な","m":"～です・～な + kata benda","p":"[kata sifat]-な です / [kata sifat] な [kata benda]","x":["Kata sifat -na (きれい, 静か, 有名, 元気...) memakai な bila berada di depan kata benda: 静かな町 = kota yang tenang.","Negatif: 静かじゃありません (tidak tenang)."],"ex":[{"t":["ここ","+は","{静|しず}か","+な","{町|まち}","+です。"],"id":"Ini kota yang tenang.","k":3,"o":["の","い","に"]},{"t":["{花子|はなこ}さん","+は","きれい","+な","{人|ひと}","+です。"],"id":"Hanako adalah orang yang cantik.","k":3,"o":["の","い","を"]},{"t":["この","{部屋|へや}","+は","{静|しず}か","+じゃありません。"],"id":"Kamar ini tidak tenang.","k":4,"o":["くないです。","でした。","なです。"]}],"o":[]},{"id":"g5-18","lv":5,"t":"kata sifat (lampau)","m":"～かったです・～でした","p":"[kata sifat -i] → ～かったです / [kata sifat -na, kata benda] → ～でした","x":["Lampau kata sifat -i: ganti い menjadi かった (高い → 高かった). Kata sifat -na dan kata benda memakai でした."],"ex":[{"t":["{昨日|きのう}","+は","{暑|あつ}","~かった","+です。"],"id":"Kemarin panas.","k":3,"o":["い","くない","でした"]},{"t":["パーティー","+は","{楽|たの}し","~かった","+です。"],"id":"Pestanya menyenangkan.","k":3,"o":["い","くない","な"]},{"t":["{町|まち}","+は","にぎやか","+でした。"],"id":"Kotanya (waktu itu) ramai.","k":3,"o":["かったです。","くないです。","なです。"]}],"o":[]},{"id":"g5-19","lv":5,"t":"～ましょう／～ませんか","m":"ayo ... / maukah ...?","p":"[kata kerja]-ましょう (ayo) / -ませんか (maukah?)","x":["～ましょう = \"Ayo ...\" untuk mengajak. ～ませんか = \"Maukah ...?\" untuk mengajak dengan lebih sopan."],"ex":[{"t":["いっしょ","+に","{帰|かえ}り","~ましょう。"],"id":"Ayo pulang bersama.","k":3,"o":["ません。","ました。"]},{"t":["{明日|あした}","{映画|えいが}","+を","{見|み}","~ませんか。"],"id":"Maukah besok menonton film (bersama)?","k":4,"o":["ます。","ました。"]},{"t":["ちょっと","{休|やす}み","~ましょう。"],"id":"Ayo istirahat sebentar.","k":2,"o":["ません。","ました。"]}],"o":[]},{"id":"g5-20","lv":5,"t":"～たいです","m":"ingin (melakukan) ...","p":"[kata kerja]-ます → -たいです","x":["Ganti ます dengan たい untuk menyatakan keinginan sendiri: 行きます → 行きたいです (ingin pergi)."],"ex":[{"t":["{日本|にほん}","+へ","{行|い}き","~たい","+です。"],"id":"Saya ingin pergi ke Jepang.","k":3,"o":["ます","ません","ました"]},{"t":["{冷|つめ}たい","{水|みず}","+が","{飲|の}み","~たい","+です。"],"id":"Saya ingin minum air dingin.","k":4,"o":["ます","ません","ました"]},{"t":["{何|なに}","+が","{食|た}べ","~たい","+です","+か。"],"id":"Kamu ingin makan apa?","k":3,"o":["ます","ません","ました"]}],"o":[]},{"id":"g5-21","lv":5,"t":"～てください","m":"tolong (lakukan) ...","p":"[kata kerja]-て ください","x":["Bentuk て + ください = permintaan sopan.","Cara membuat bentuk て: 食べます → 食べて, 見ます → 見て, 書きます → 書いて, 待ちます → 待って, 読みます → 読んで, します → して, 来ます → 来て."],"ex":[{"t":["ちょっと","{待|ま}って","ください。"],"id":"Tolong tunggu sebentar.","k":1,"o":["{待|ま}ちます","{待|ま}つ","{待|ま}った"]},{"t":["ここ","+に","{名前|なまえ}","+を","{書|か}いて","ください。"],"id":"Tolong tulis nama di sini.","k":4,"o":["{書|か}きます","{書|か}く","{書|か}いた"]},{"t":["もう","{一度|いちど}","{言|い}って","ください。"],"id":"Tolong katakan sekali lagi.","k":2,"o":["{言|い}います","{言|い}う","{言|い}った"]}],"o":[]},{"id":"g5-22","lv":5,"t":"～ています","m":"sedang ...; keadaan","p":"[kata kerja]-て います","x":["Menyatakan kegiatan yang sedang berlangsung (sedang makan) atau keadaan yang berlanjut (tinggal di..., sudah menikah)."],"ex":[{"t":["{今|いま}","{雨|あめ}","+が","{降|ふ}って","います。"],"id":"Sekarang sedang hujan.","k":4,"o":["あります。","ください。","です。"]},{"t":["{兄|あに}","+は","{東京|とうきょう}","+に","{住|す}んで","います。"],"id":"Kakak laki-laki saya tinggal di Tokyo.","k":5,"o":["あります。","ください。","です。"]},{"t":["{田中|たなか}さん","+は","{電話|でんわ}","+を","して","います。"],"id":"Pak Tanaka sedang menelepon.","k":5,"o":["あります。","ください。","です。"]}],"o":[]},{"id":"g5-23","lv":5,"t":"～てもいいです","m":"boleh ...","p":"[kata kerja]-て も いいです(か)","x":["Untuk meminta atau memberi izin: 写真を撮ってもいいですか = Bolehkah saya memotret?"],"ex":[{"t":["{写真|しゃしん}","+を","{撮|と}って","+も","いい","+です","+か。"],"id":"Bolehkah saya memotret?","k":3,"o":["は","を","が"]},{"t":["ここ","+に","{座|すわ}って","+も","いい","+です。"],"id":"Boleh duduk di sini.","k":3,"o":["は","を","が"]},{"t":["{窓|まど}","+を","{開|あ}けて","+も","いい","+です","+か。"],"id":"Bolehkah saya membuka jendela?","k":3,"o":["は","を","が"]}],"o":[]},{"id":"g5-24","lv":5,"t":"～てはいけません","m":"tidak boleh ...","p":"[kata kerja]-て は いけません","x":["Larangan: ここでたばこを吸ってはいけません = Dilarang merokok di sini."],"ex":[{"t":["ここ","+で","たばこ","+を","{吸|す}って","+は","いけません。"],"id":"Tidak boleh merokok di sini.","k":5,"o":["も","を","が"]},{"t":["{教室|きょうしつ}","+で","{食|た}べて","+は","いけません。"],"id":"Tidak boleh makan di ruang kelas.","k":3,"o":["も","を","に"]},{"t":["{写真|しゃしん}","+を","{撮|と}って","+は","いけません。"],"id":"Tidak boleh memotret.","k":3,"o":["も","を","が"]}],"o":[]},{"id":"g5-25","lv":5,"t":"～ないでください","m":"tolong jangan ...","p":"[kata kerja]-ない で ください","x":["Bentuk ない (negatif santai) + でください = meminta orang untuk tidak melakukan sesuatu.","Contoh bentuk ない: 食べます → 食べない, 行きます → 行かない, します → しない, 来ます → 来ない."],"ex":[{"t":["ここ","+に","{車|くるま}","+を","{止|と}めない","+で","ください。"],"id":"Tolong jangan parkir mobil di sini.","k":5,"o":["て","に","を"]},{"t":["{忘|わす}れない","+で","ください。"],"id":"Tolong jangan lupa.","k":1,"o":["て","に","を"]},{"t":["{心配|しんぱい}しない","+で","ください。"],"id":"Tolong jangan khawatir.","k":1,"o":["て","に","を"]}],"o":[]},{"id":"g5-26","lv":5,"t":"～から","m":"karena ...","p":"[kalimat 1] から、[kalimat 2]","x":["から setelah sebuah kalimat berarti \"karena\". Alasan diletakkan di depan: 暑いですから、窓を開けます = Karena panas, saya membuka jendela."],"ex":[{"t":["{暑|あつ}い","+です","+から、","{窓|まど}","+を","{開|あ}けます。"],"id":"Karena panas, saya membuka jendela.","k":2,"o":["まで、","が、","と、"]},{"t":["{時間|じかん}","+が","ありません","+から、","タクシー","+で","{行|い}きます。"],"id":"Karena tidak ada waktu, saya naik taksi.","k":3,"o":["まで、","を、","と、"]},{"t":["{病気|びょうき}","+です","+から、","{休|やす}みます。"],"id":"Karena sakit, saya beristirahat.","k":2,"o":["まで、","が、","に、"]}],"o":[]},{"id":"g5-27"